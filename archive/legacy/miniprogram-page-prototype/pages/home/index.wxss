.home-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  min-height: 520rpx;
}

.hero-wash {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(246, 242, 236, 0.28), rgba(246, 242, 236, 0.9)),
    linear-gradient(120deg, rgba(18, 23, 28, 0.14), rgba(18, 23, 28, 0));
}

.hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 18rpx;
  min-height: 520rpx;
  padding: 40rpx 34rpx;
}

.hero-title {
  width: 280rpx;
}

.hero-tagline {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e242a;
}

.hero-quote {
  max-width: 540rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #55606e;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 8rpx;
}

.hero-actions .is-disabled {
  opacity: 0.46;
}

.panel-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.difficulty-panel,
.stats-panel,
.guide-panel {
  padding: 28rpx;
}

.difficulty-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.difficulty-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(67, 75, 89, 0.1);
}

.difficulty-item.is-active {
  background: linear-gradient(135deg, rgba(34, 42, 53, 0.94), rgba(73, 83, 98, 0.94));
  border-color: rgba(34, 42, 53, 0.84);
}

.difficulty-item.is-active .difficulty-title,
.difficulty-item.is-active .difficulty-copy,
.difficulty-item.is-active .difficulty-badge {
  color: #f7f4ef;
}

.difficulty-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.difficulty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f242b;
}

.difficulty-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #566172;
  background: rgba(32, 37, 45, 0.08);
}

.difficulty-copy {
  font-size: 24rpx;
  line-height: 1.7;
  color: #65707f;
}

.stats-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
}

.stats-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f242b;
}

.stats-label {
  font-size: 22rpx;
  color: #64707e;
}

.guide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.compact {
  min-height: 68rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.guide-body,
.guide-collapsed {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.guide-actions {
  margin-top: 20rpx;
}
