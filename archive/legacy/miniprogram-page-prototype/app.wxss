page {
  min-height: 100%;
  background:
    linear-gradient(180deg, rgba(243, 239, 230, 0.98), rgba(236, 232, 222, 0.98)),
    #f3efe6;
  color: #1f242b;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
image {
  box-sizing: border-box;
}

.app-shell {
  min-height: 100vh;
  padding: calc(24rpx + env(safe-area-inset-top)) 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.ink-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(67, 75, 89, 0.12);
  border-radius: 32rpx;
  background: rgba(255, 252, 247, 0.9);
  box-shadow: 0 24rpx 60rpx rgba(34, 42, 53, 0.08);
}

.ink-card::after {
  content: "";
  position: absolute;
  inset: auto -8% -20% auto;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(26, 33, 41, 0.08), rgba(26, 33, 41, 0));
  pointer-events: none;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #4c5768;
  letter-spacing: 2rpx;
}

.section-copy {
  font-size: 24rpx;
  line-height: 1.7;
  color: #5e6776;
}

.primary-button,
.secondary-button,
.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.primary-button {
  color: #f6f6f3;
  background: linear-gradient(135deg, #20252d, #46505f);
  box-shadow: 0 16rpx 32rpx rgba(32, 37, 45, 0.18);
}

.secondary-button {
  color: #1f242b;
  background: rgba(247, 244, 238, 0.95);
  border: 1rpx solid rgba(67, 75, 89, 0.16);
}

.ghost-button {
  color: #4f5a6a;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx dashed rgba(67, 75, 89, 0.18);
}
